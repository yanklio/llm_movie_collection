# Movie RAG System Configuration

# OMDb API - Get your key at http://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=your_omdb_api_key_here

# OpenRouter API - Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: LLM Model (default: mistralai/mistral-7b-instruct)
LLM_MODEL=mistralai/mistral-7b-instruct

# Optional: ChromaDB persistence directory
CHROMA_PERSIST_DIR=./chroma_db
