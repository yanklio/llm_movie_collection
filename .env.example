# Movie RAG System Configuration

# TMDB API - Get your key at https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# OpenRouter API - Get your key at https://openrouter.ai/keys
GROQ_API_KEY=your_openrouter_api_key_here

# Optional: LLM Model (default: openai/gpt-oss-20b:free - supports tool calling)
LLM_MODEL=openai/gpt-oss-20b

# Optional: ChromaDB persistence directory
CHROMA_PERSIST_DIR=./chroma_db
